# Copy this file to .env, generate fresh secrets, and keep .env local.
# Never commit real credentials or API keys.

POSTGRES_DB=dark_signal
POSTGRES_USER=dark_signal_user
POSTGRES_PASSWORD=

# Generate each value independently with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
BOOTSTRAP_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_BASE_URL=http://localhost:3000
SIMULATION_LINK_BASE_URL=http://localhost:8000

# Optional: the assistant uses a safe rule-based fallback when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=45

# Optional: required only for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
SMTP_SANDBOX_MODE=false
SMTP_SANDBOX_RECIPIENT=
